# ═══════════════════════════════════════════════════════════
#  ملف بيئة السيرفر الرئيسي (Server 1) — npm start
#  الرئيسي هو الوحيد الذي يُشترط فيه TG_TOKEN ويشغّل بوت تيليجرام + لوحة التحكم
# ═══════════════════════════════════════════════════════════

ROLE=main

# توكن بوت تيليجرام من @BotFather — إلزامي على الرئيسي فقط
TG_TOKEN=123456:ABC-DEF_your_real_token_here

# معرفات المطورين (تيليجرام) مفصولة بفاصلة
DEV_IDS=111111111,222222222

# سر مشترك بين الرئيسي والعمال (اجعله قوياً ومطابقاً في كل الملفات)
API_SECRET=change_me_to_a_long_random_secret

# بورت واجهة الرئيسي
MAIN_PORT=3000
MAIN_URL=http://127.0.0.1:3000
LOCAL_SERVER_NAME=server1
MAX_SESSIONS=4

# ═══ لوحة التحكم (الواجهة الفاخرة) ═══
DASHBOARD_ENABLED=true
# ⚠️ غيّرها فوراً — هي مفتاح الدخول لكل شيء
DASHBOARD_PASSWORD=admin123
# مدة صلاحية جلسة الدخول (ملّي ثانية) — 12 ساعة افتراضياً
DASHBOARD_TTL_MS=43200000

# ═══ محرّك الحالات: مشاهدة + قسم الحالات التي تمت مشاهدتها + تفاعل ═══
# أقصى عدد حالات تُعالَج في الوقت نفسه لكل رقم
STATUS_CONCURRENCY=8
# الوضع السريع: بلا أي تأخير اصطناعي (المطلوب: أقل من ثانية لكل حالة)
STATUS_FAST_MODE=true
# إزالة مؤشر غير المقروء بعد إيصال المشاهدة (حيث تدعم نسخة Baileys ذلك)
STATUS_MARK_READ=true
# المشاهدة التلقائية لكل حالة جديدة
STATUS_AUTO_VIEW=true
# التفاعل التلقائي على كل حالة جديدة (يبدأ فوراً، بالتوازي مع المشاهدة)
STATUS_AUTO_LIKE=true
# إيموجي الإعجاب
STATUS_LIKE_EMOJI=❤️
# تأخير أقصى (0 = بلا تأخير؛ يُستخدم فقط إن عطّلت الوضع السريع)
STATUS_MAX_DELAY_MS=0
# متغير توافق قديم؛ لا يؤخر وحدة التفاعل المنفصلة
STATUS_REACT_DELAY_MS=0
# متغير توافق قديم؛ يحاول المحرك مسار sendMessage ثم relayMessage مباشرة
STATUS_REACT_RETRIES=2

# ═══ محرّك التحميل من المنصات (تيك توك/إنستغرام/فيسبوك/يوتيوب/إكس) ═══
DOWNLOADER_ENABLED=true
YTDLP_BIN=yt-dlp
FFMPEG_BIN=/usr/bin/ffmpeg
DOWNLOADER_MAX_MB=60
DOWNLOADER_TIMEOUT_MS=180000
DOWNLOADER_CONCURRENCY=2
# بروكسي اختياري (مفيد إن كان السيرفر محجوباً): http://user:pass@host:port
YTDLP_PROXY=
# اختياري للمحتوى الذي يملك الحساب صلاحية مشاهدته فقط؛ لا ترسل الكوكيز للبوت.
YTDLP_COOKIES_FILE=
# مثال: chrome أو chrome:Default (اتركه فارغاً افتراضياً)
YTDLP_COOKIES_FROM_BROWSER=

# ─────────── محرك إنستغرام المباشر (Node fetch فقط) ───────────
# اتركه فارغاً للروابط العامة. للروابط الخاصة استخدم كوكيز حساب
# يملك صلاحية المشاهدة في ملف محلي بصيغة Cookie header أو cookies.txt.
INSTAGRAM_COOKIE_FILE=
# بديل اختياري: YOUTUBE_COOKIES_FILE=
# بديل اختياري لملف كوكيز يوتيوب بصيغة Netscape
INSTAGRAM_COOKIE=اسم=قيمة; اسم2=قيمة2
YOUTUBE_COOKIES_FILE=
# بديل اختياري لملف كوكيز يوتيوب بصيغة Netscape
INSTAGRAM_COOKIE=

# ═══ تجهيز أدوات التحميل تلقائياً عند تشغيل السيرفر ═══
# يبحث عن yt-dlp و ffmpeg، وإن لم يجدهما يثبّتهما بنفسه:
#   yt-dlp : python3 -m pip install -U yt-dlp ← ثم الملف التنفيذي المستقل ← apt ← pipx
#   ffmpeg : حزمة npm ffmpeg-static ← imageio-ffmpeg (pip) ← نسخة ثابتة ← apt
AUTO_INSTALL_TOOLS=true
# فحص تحديث yt-dlp عند كل إقلاع (يوتيوب يتغيّر باستمرار — يُنصح بإبقائه true)
YTDLP_AUTO_UPDATE=true
# مجلد حفظ الأدوات التي يُنزّلها النظام بنفسه (bin/yt-dlp و bin/ffmpeg)
TOOLS_BIN_DIR=./bin
# مسار بايثون إن كان غير افتراضي (يُكتشف تلقائياً أيضاً)
# PYTHON_BIN=python3
# أقصى حجم فيديو يُرسل مباشرة عبر واتساب (وما فوقه يُضغط تلقائياً)
WA_VIDEO_MAX_MB=45
# فوق هذا الحد يُرسل الملف كمرفق (مستند) إن تعذّر الضغط
WA_HARD_MAX_MB=60

# ═══ الإذاعة (تخفيف الحظر) ═══
BROADCAST_WA_DELAY_MIN_MS=3000
BROADCAST_WA_DELAY_MAX_MS=7000

# ═══ الرد الذكي في الخاص فقط ═══
# OPENAI_API_KEY=ضع_المفتاح_هنا
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ═══ الانضمام التلقائي لقناة واتساب بعد ربط أي رقم ═══
WA_CHANNEL_INVITE=0029Vb8AkYM2v1IuuBl6cy0W
WA_AUTO_FOLLOW=true

LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════
#  ملف بيئة سيرفر عامل (Server 2، 3، 4…) — npm run worker
#  ⚠️ لا حاجة لأي TG_TOKEN على العامل إطلاقاً
# ═══════════════════════════════════════════════════════════
#
# ROLE=worker
# WORKER_NAME=server2
# WORKER_PORT=3001
# WORKER_URL=http://IP_العامل:3001
# MAIN_API_URL=http://IP_السيرفر_الرئيسي:3000
# API_SECRET=نفس_السر_المشترك_المضبوط_على_الرئيسي
# MAX_SESSIONS=4
# DASHBOARD_ENABLED=true
# DASHBOARD_PASSWORD=نفس_كلمة_مرور_الرئيسي_أو_أخرى
# LOG_LEVEL=info

# ─────────── مصادقة yt-dlp الاختيارية ───────────
# الروابط العامة تُحمَّل بلا كوكيز. استخدم الإعدادات التالية فقط لحساب يملك
# صلاحية مشاهدة المحتوى؛ لا تضع قيمة الكوكيز نفسها في هذا الملف أو داخل البوت.
# YTDLP_COOKIES_FILE=/مسار/محلي/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome:Default
# يُحدَّث yt-dlp تلقائياً قبل كل تحميل (مرة كل 12 ساعة كحد أقصى).

# ─────────── تفاعل الحالات متعدد الإيموجي (v3.13) ───────────
# rotate (افتراضي) = كل حالة جديدة تأخذ الإيموجي التالي من قائمتك بالتناوب ← مضمون
#                     في كل الإصدارات (واتساب يعطي كل مُتفاعِل تفاعلاً واحداً فقط).
# single = الأول فقط على كل الحالات.
# joined = دمج كل الإيموجيات في نصّ تفاعل واحد (اختياري): ليس تفاعلاً متعدداً
#          رسمياً — بعض العملاء يعرضون الرموز كاملة وبعضهم الأول فقط.
STATUS_REACTION_MODE=rotate
# ★ v3.14: مهلة طلب كود الاقتران (ملّي ثانية) — لا يبقى الطلب معلّقاً بلا رد
PAIRING_REQUEST_TIMEOUT_MS=30000

# ═══════════ ★ v3.14: الذكاء الاصطناعي (مفتاح آمن — بلا أي مفتاح مضمَّن في الكود) ═══════════
# ضع مفتاحك هنا (أو عيّن مفتاحاً خاصاً لكل رقم من البوت/لوحة التحكم).
# لا يمكن لأحد غيرك إصدار مفتاح صحيح — المفتاح من المزوّد نفسه.
AI_ENABLED=true
AI_PROVIDER=auto                         # أو groq عند استخدام مفتاح Groq
AI_API_KEY=
# Groq يستخدم تلقائياً https://api.groq.com/openai/v1 ولا يحتاج AI_API_BASE.
# رابط مخصّص فقط عند استخدام مزوّد متوافق آخر.
AI_API_BASE=
# Groq: llama-3.3-70b-versatile (والكود يحوّل الأسماء القديمة تلقائياً)
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=30000
AI_RETRIES=2
# عدد أدوار ذاكرة المحادثة لكل رقم (0 = بلا ذاكرة)
AI_MEMORY_TURNS=6
AI_SYSTEM_PROMPT=

# ═══════════ ★ v3.14: قناة الواتساب الرسمية (انضمام تلقائي بعد نجاح الربط) ═══════════
WA_AUTO_FOLLOW=true
WA_CHANNEL_INVITE=0029Vb8AkYM2v1IuuBl6cy0W
WA_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8AkYM2v1IuuBl6cy0W
# أقصى عدد إيموجيات تُدمج في التفاعل الواحد
STATUS_REACTION_MAX_EMOJIS=5

# ═══ ★ v3.8: الأوامر المخصّصصة وملفات الأوامر (اختياري — لهما مسارات افتراضية) ═══
# مسار ملف الأوامر النصية التي يضيفها المطور من بوت تيليجرام
# CUSTOM_COMMANDS_FILE=./data/custom-commands.json
# مجلد ملفات الأوامر البرمجية المرفوعة لكل رقم مربوط
# SESSION_COMMANDS_DIR=./data/session-commands

# ═══ ★ v3.12: مزامنة السيرفرات التلقائية (Master → Slaves) ═══
# على الرئيسي: لا شيء مطلوب — هو مصدر الحقيقة ويوزع الأمر عند إعادة تشغيله
# على كل عامل: فعّل المزامنة ووجّهه لرابط الرئيسي
FLEET_SYNC=true
FLEET_AUTO_RESTART=true
FLEET_POLL_MS=30000
# MAIN_API_URL=http://IP_الرئيسي:3000

# ═══ ★ v3.12: واجهة القائمة التفاعلية ═══
# MENU_IMAGE_FILE=./assets/menu-luffy.png
# MENU_IMAGE_URL=

# ═══════════ ★ v3.15: نظام الدعم الفني (مستخدم ← مطور ← مستخدم) ═══════════
# تفعيل/تعطيل نظام الدعم بالكامل
SUPPORT_ENABLED=true
# رقم المطور الرئيسي الذي تصل إليه كل رسائل الدعم (أرقام فقط بصيغة دولية بلا +)
SUPPORT_DEV_NUMBER=967773987296
# أرقام مطورين إضافيين (اختياري) مفصولة بفواصل — تصلهم نسخة من كل تذكرة
SUPPORT_DEV_NUMBERS=
# أقل مدة (ملّي ثانية) بين تذكرتين لنفس المستخدم
SUPPORT_COOLDOWN_MS=15000
# أقصى طول لنص المشكلة المحفوظ
SUPPORT_MAX_LEN=2000
# إشعار المطور بعد إرسال ردّه بنجاح
SUPPORT_NOTIFY_DEV=true

# ═══════════ ★ v3.15: قناة الواتساب الرسمية — رابط ومعرّف ═══════════
WA_CHANNEL_INVITE=0029Vb8AkYM2v1IuuBl6cy0W
WA_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8AkYM2v1IuuBl6cy0W
# معرّف القناة (jid) — اتركه فارغاً ليُستخرج تلقائياً من رمز الدعوة
# WA_CHANNEL_JID=120363xxxxxxxxxx@newsletter
WA_AUTO_FOLLOW=true
